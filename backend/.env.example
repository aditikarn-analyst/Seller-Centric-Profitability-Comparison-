# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# Application
APP_NAME="Marketplace Profitability Analyzer"
ENVIRONMENT=development          # development | production

# Database — SQLite for dev, PostgreSQL DSN for prod (§10)
DATABASE_URL=sqlite:///./app.db
# Production example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marketplace

# Auth (§10) — generate a real secret before any deployment
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
